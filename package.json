{
  "name": "audio-transcriber",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Local web app: multi-hour Bulgarian audio recordings -> speaker-separated, reviewed, exportable transcripts.",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "kill:dev": "node scripts/kill-dev.mjs",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "tsc": "tsc -b",
    "lint": "eslint . --cache --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --cache --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "gates": "node scripts/gates.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.13.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
